---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  schema?: object;
}

const {
  title = "Sanjay Properties | Sanjay Garden, Saravanampatti, Coimbatore",
  description = "Discover Sanjay Garden, a residential address in Saravanampatti, Coimbatore by Sanjay Properties. Explore the layout, location, and project details.",
  ogImage = "/og-image.jpg",
  schema
} = Astro.props;

import '../index.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo/logo-black.png" />
    <link rel="apple-touch-icon" href="/logo/logo-black.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    {schema ? (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ) : (
      <script type="application/ld+json">
        {JSON.stringify({
          "@context": "https://schema.org",
          "@type": "RealEstateAgent",
          "name": "Sanjay Properties",
          "description": "Real estate and housing development firm associated with Sanjay Garden in Saravanampatti, Coimbatore.",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Sanjay Garden, PNT Colony, Saravanampatti",
            "addressLocality": "Coimbatore",
            "addressRegion": "Tamil Nadu",
            "postalCode": "641035",
            "addressCountry": "IN"
          }
        })}
      </script>
    )}
  </head>
  <body class="bg-[#f5f6f8] text-[#111213] antialiased selection:bg-[#FFCC00] selection:text-black min-h-screen flex flex-col font-sans">
    <slot />
  </body>
</html>
